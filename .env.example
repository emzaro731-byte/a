# V7 production configuration

# Server-to-server API key. Keep private; do NOT ship this in a Flutter APK.
AI_API_KEY=replace-with-a-long-random-api-key
REQUIRE_API_KEY=true

# JWT signing secret. Use a random value of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
DAILY_REQUEST_LIMIT=1000

# Chat / Ollama
OLLAMA_URL=http://ollama:11434
AI_MODEL=qwen2.5:3b
AI_FAST_MODEL=qwen2.5:3b
AI_REASONING_MODEL=qwen2.5:3b
AI_CODING_MODEL=qwen2.5:3b
AI_VISION_MODEL=qwen2.5:3b

# Native Flutter normally does not need CORS. Restrict this for web clients.
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_CONTEXT_MESSAGES=40

AI_SYSTEM_PROMPT=You are a helpful, accurate, capable AI assistant. Think carefully, explain clearly, use tools when appropriate, and never invent facts when uncertain.

# Media gateway (internal Docker network)
IMAGE_GENERATOR_URL=http://media:8100/v1/images/generations
VIDEO_GENERATOR_URL=http://media:8100/v1/videos/generations
MUSIC_GENERATOR_URL=http://media:8100/v1/audio/music/generations
MEDIA_GENERATOR_TOKEN=
