# Ollama server
OLLAMA_URL=http://127.0.0.1:11434

# Models. Use aliases from Flutter/API: default, fast, reasoning, coding
AI_MODEL=qwen2.5:3b
AI_FAST_MODEL=qwen2.5:3b
AI_REASONING_MODEL=qwen2.5:3b
AI_CODING_MODEL=qwen2.5:3b

# Set a long random value in production
AI_API_KEY=change-me

# Restrict this in production
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# Optional system behavior
AI_SYSTEM_PROMPT=You are a helpful, accurate, concise AI assistant. Think carefully, explain clearly, and never invent facts when you are uncertain.
