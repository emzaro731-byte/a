# AI API v4 production configuration

# Chat / Ollama
OLLAMA_URL=http://ollama:11434
AI_MODEL=qwen2.5:3b
AI_FAST_MODEL=qwen2.5:3b
AI_REASONING_MODEL=qwen2.5:3b
AI_CODING_MODEL=qwen2.5:3b

# REQUIRED in production. Replace with a long random secret.
AI_API_KEY=replace-with-a-long-random-secret
REQUIRE_API_KEY=true

# Direct model names clients may request.
ALLOWED_MODELS=qwen2.5:3b

# Native Flutter apps normally do not need CORS. Restrict this for web clients.
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

AI_SYSTEM_PROMPT=You are a helpful, accurate, concise AI assistant. Think carefully, explain clearly, and never invent facts when you are uncertain.

# Media gateway (internal Docker network)
IMAGE_GENERATOR_URL=http://media:8100/v1/images/generations
VIDEO_GENERATOR_URL=http://media:8100/v1/videos/generations
MUSIC_GENERATOR_URL=http://media:8100/v1/audio/music/generations
MEDIA_GENERATOR_TOKEN=
