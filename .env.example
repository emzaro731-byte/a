# V10.2 self-hosted AI platform configuration
AI_API_KEY=replace-with-a-long-random-api-key
REQUIRE_API_KEY=true

POSTGRES_DB=supabase
POSTGRES_USER=supabase
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DSN=postgresql://supabase:replace-with-a-long-random-password@postgres:5432/supabase
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-long-random-service-role-key
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
DAILY_REQUEST_LIMIT=1000

# Use stronger models appropriate to your GPU. These are examples, not bundled models.
AI_MODEL=qwen2.5:14b
AI_FAST_MODEL=qwen2.5:7b
AI_REASONING_MODEL=qwen2.5:32b
AI_CODING_MODEL=qwen2.5-coder:14b
AI_VISION_MODEL=qwen2.5-vl:7b

AI_GATEWAY_DEFAULT=local:qwen2.5:14b
AI_GATEWAY_FAST=local:qwen2.5:7b
AI_GATEWAY_REASONING=local:qwen2.5:32b
AI_GATEWAY_CODING=local:qwen2.5-coder:14b
AI_GATEWAY_VISION=local:qwen2.5-vl:7b

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_PROVIDER2_BASE_URL=
AI_PROVIDER2_API_KEY=
AI_PROVIDER3_BASE_URL=
AI_PROVIDER3_API_KEY=
LOCAL_AI_BASE_URL=http://ollama:11434
LOCAL_AI_API_KEY=

CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_CONTEXT_MESSAGES=40
AI_LONG_TASK_CHARS=8000
AI_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_SECONDS=30
AI_SYSTEM_PROMPT=You are a highly capable, careful AI assistant. Reason systematically, verify claims when tools or sources are available, follow instructions precisely, and clearly distinguish known facts from uncertainty.

STORAGE_ROOT=/data/storage
IMAGE_GENERATOR_URL=http://media:8100/v1/images/generations
VIDEO_GENERATOR_URL=http://media:8100/v1/videos/generations
MUSIC_GENERATOR_URL=http://media:8100/v1/audio/music/generations
MEDIA_GENERATOR_TOKEN=
